{
  "openapi": "3.1.0",
  "info": {
    "title": "EasyAudit-Next API",
    "version": "0.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["system"]
      }
    },
    "/api/v1/meta/domain-model": {
      "get": {
        "operationId": "getDomainModel",
        "tags": ["meta"]
      }
    },
    "/api/v1/auth/login": {
      "post": {"operationId": "login", "tags": ["auth"]}
    },
    "/api/v1/auth/logout": {
      "post": {"operationId": "logout", "tags": ["auth"]}
    },
    "/api/v1/me": {
      "get": {"operationId": "getMe", "tags": ["me"]}
    },
    "/api/v1/me/sessions": {
      "get": {"operationId": "listMySessions", "tags": ["me"]}
    },
    "/api/v1/me/sessions/{session_id}": {
      "delete": {"operationId": "revokeMySession", "tags": ["me"]}
    },
    "/api/v1/admin/organization": {
      "get": {"operationId": "getAdminOrganization", "tags": ["admin"]}
    },
    "/api/v1/admin/departments": {
      "get": {"operationId": "listAdminDepartments", "tags": ["admin"]},
      "post": {"operationId": "createAdminDepartment", "tags": ["admin"]}
    },
    "/api/v1/admin/departments/{department_id}": {
      "patch": {"operationId": "updateAdminDepartment", "tags": ["admin"]}
    },
    "/api/v1/admin/users": {
      "get": {"operationId": "listAdminUsers", "tags": ["admin"]},
      "post": {"operationId": "createAdminUser", "tags": ["admin"]}
    },
    "/api/v1/admin/users/{user_id}": {
      "get": {"operationId": "getAdminUser", "tags": ["admin"]},
      "patch": {"operationId": "updateAdminUser", "tags": ["admin"]}
    },
    "/api/v1/admin/scenarios": {
      "get": {"operationId": "listAdminScenarios", "tags": ["admin"]}
    },
    "/api/v1/admin/scenarios/{key}/versions": {
      "get": {"operationId": "listAdminScenarioVersions", "tags": ["admin"]}
    },
    "/api/v1/review-plans": {
      "get": {"operationId": "listReviewPlans", "tags": ["review-planning"]},
      "post": {"operationId": "createReviewPlan", "tags": ["review-planning"]}
    },
    "/api/v1/review-plans/{plan_id}": {
      "get": {"operationId": "getReviewPlan", "tags": ["review-planning"]}
    },
    "/api/v1/review-cases": {
      "get": {"operationId": "listReviewCases", "tags": ["review-planning"]},
      "post": {"operationId": "createReviewCase", "tags": ["review-planning"]}
    },
    "/api/v1/review-cases/{case_id}": {
      "get": {"operationId": "getReviewCase", "tags": ["review-planning"]}
    },
    "/api/v1/review-cases/{case_id}/members": {
      "get": {"operationId": "listReviewCaseMembers", "tags": ["review-planning"]},
      "post": {"operationId": "addReviewCaseMember", "tags": ["review-planning"]}
    },
    "/api/v1/review-cases/{case_id}/transitions": {
      "post": {"operationId": "transitionReviewCase", "tags": ["review-planning"]}
    },
    "/api/v1/review-cases/{case_id}/findings": {
      "get": {"operationId": "listFindings", "tags": ["review-findings"]},
      "post": {"operationId": "createFinding", "tags": ["review-findings"]}
    },
    "/api/v1/findings/{finding_id}": {
      "get": {"operationId": "getFinding", "tags": ["review-findings"]}
    },
    "/api/v1/findings/{finding_id}/participants": {
      "get": {"operationId": "listFindingParticipants", "tags": ["review-findings"]},
      "post": {"operationId": "addFindingParticipant", "tags": ["review-findings"]}
    },
    "/api/v1/findings/{finding_id}/transitions": {
      "post": {"operationId": "transitionFinding", "tags": ["review-findings"]}
    }
  }
}
