{
  "openapi": "3.1.0",
  "info": {
    "title": "EasyAudit-Next API",
    "version": "0.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "tags": ["system"]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "tags": ["system"]
      }
    },
    "/api/v1/meta/domain-model": {
      "get": {
        "operationId": "getDomainModel",
        "tags": ["meta"]
      }
    },
    "/api/v1/auth/login": {
      "post": {"operationId": "login", "tags": ["auth"], "responses": ["200", "401", "429"]}
    },
    "/api/v1/auth/logout": {
      "post": {"operationId": "logout", "tags": ["auth"]}
    },
    "/api/v1/me": {
      "get": {"operationId": "getMe", "tags": ["me"]}
    },
    "/api/v1/me/password": {
      "post": {"operationId": "changeMyPassword", "tags": ["me"]}
    },
    "/api/v1/me/sessions": {
      "get": {"operationId": "listMySessions", "tags": ["me"]}
    },
    "/api/v1/me/sessions/{session_id}": {
      "delete": {"operationId": "revokeMySession", "tags": ["me"]}
    },
    "/api/v1/me/workbench": {
      "get": {"operationId": "getMyWorkbench", "tags": ["workbench"]}
    },
    "/api/v1/admin/organization": {
      "get": {"operationId": "getAdminOrganization", "tags": ["admin"]}
    },
    "/api/v1/admin/departments": {
      "get": {"operationId": "listAdminDepartments", "tags": ["admin"]},
      "post": {"operationId": "createAdminDepartment", "tags": ["admin"]}
    },
    "/api/v1/admin/departments/{department_id}": {
      "patch": {"operationId": "updateAdminDepartment", "tags": ["admin"]}
    },
    "/api/v1/admin/users": {
      "get": {"operationId": "listAdminUsers", "tags": ["admin"]},
      "post": {"operationId": "createAdminUser", "tags": ["admin"]}
    },
    "/api/v1/admin/users/{user_id}": {
      "get": {"operationId": "getAdminUser", "tags": ["admin"]},
      "patch": {"operationId": "updateAdminUser", "tags": ["admin"]}
    },
    "/api/v1/admin/users/{user_id}/credential-reset": {
      "post": {"operationId": "resetAdminUserCredential", "tags": ["admin"]}
    },
    "/api/v1/admin/scenarios": {
      "get": {"operationId": "listAdminScenarios", "tags": ["admin"]}
    },
    "/api/v1/admin/scenarios/{key}/versions": {
      "get": {"operationId": "listAdminScenarioVersions", "tags": ["admin"]}
    },
    "/api/v1/admin/scenario-status": {
      "get": {"operationId": "getAdminScenarioStatus", "tags": ["admin"]}
    },
