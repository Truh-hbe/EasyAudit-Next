    "/api/v1/findings/{finding_id}/actions": {
      "get": {"operationId": "listActionItems", "tags": ["review-rectification"]},
      "post": {"operationId": "createActionItem", "tags": ["review-rectification"]}
    },
    "/api/v1/action-items/{action_item_id}": {
      "get": {"operationId": "getActionItem", "tags": ["review-rectification"]}
    },
    "/api/v1/action-items/{action_item_id}/assignees": {
      "get": {"operationId": "listActionAssignees", "tags": ["review-rectification"]},
      "post": {"operationId": "addActionAssignee", "tags": ["review-rectification"]}
    },
    "/api/v1/action-items/{action_item_id}/transitions": {
      "post": {"operationId": "transitionActionItem", "tags": ["review-rectification"]}
    },
    "/api/v1/action-items/{action_item_id}/transfer-and-reopen": {
      "post": {"operationId": "transferAndReopenActionItem", "tags": ["review-rectification"]}
    },
    "/api/v1/action-items/{action_item_id}/evidences": {
      "get": {"operationId": "listActionEvidences", "tags": ["review-rectification"]}
    },
    "/api/v1/action-items/{action_item_id}/evidence-uploads": {
      "post": {
        "operationId": "uploadActionEvidence",
        "tags": ["review-rectification"],
        "responses": ["201", "413", "415", "503"]
