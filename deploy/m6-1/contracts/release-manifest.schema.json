{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaudit.invalid/m6.1/release-manifest.schema.json",
  "title": "M6.1 Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "x-model-fields": ["config_revision", "created_at", "manifest_sha256", "release_digests", "release_set_id", "schema", "schema_version", "secret_refs", "signer_key_ref"],
  "required": ["config_revision", "created_at", "manifest_sha256", "release_digests", "release_set_id", "schema", "schema_version", "secret_refs", "signer_key_ref"],
  "properties": {
    "schema_version": {"const": "m6.1.release-manifest.v1"},
    "release_set_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "release_digests": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "config_revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "schema": {"type": "object", "additionalProperties": false, "required": ["postgres_major", "alembic_head"], "properties": {"postgres_major": {"const": 17}, "alembic_head": {"type": "string"}}},
    "secret_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signer_key_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
  }
}
