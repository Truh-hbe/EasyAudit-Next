{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaudit.invalid/m6.1/recovery-set.schema.json",
  "title": "M6.1 Recovery Set",
  "type": "object",
  "additionalProperties": false,
  "x-model-fields": ["config_revision", "cut_started_at", "manifest_sha256", "object_root", "postgres_backup", "primary_failure_domain_ref", "recovery_set_cut_completed", "recovery_set_id", "release_digests", "release_set_id", "restore_order", "schema", "schema_version", "secret_refs", "signer_key_ref"],
  "required": ["config_revision", "cut_started_at", "manifest_sha256", "object_root", "postgres_backup", "primary_failure_domain_ref", "recovery_set_cut_completed", "recovery_set_id", "release_digests", "release_set_id", "restore_order", "schema", "schema_version", "secret_refs", "signer_key_ref"],
  "properties": {
    "schema_version": {"const": "m6.1.recovery-set.v1"},
    "recovery_set_id": {"type": "string"},
    "release_set_id": {"type": "string"},
    "cut_started_at": {"type": "string", "format": "date-time"},
    "recovery_set_cut_completed": {"type": "string", "format": "date-time"},
    "release_digests": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "config_revision": {"type": "string"},
    "secret_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}},
    "postgres_backup": {"type": "object", "additionalProperties": false, "required": ["id", "completed_at", "failure_domain_ref"], "properties": {"id": {"type": "string"}, "completed_at": {"type": "string", "format": "date-time"}, "failure_domain_ref": {"type": "string"}}},
    "object_root": {"type": "object", "additionalProperties": false, "required": ["id", "count", "content_root"], "properties": {"id": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "content_root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "schema": {"type": "object", "additionalProperties": false, "required": ["postgres_major", "alembic_head"], "properties": {"postgres_major": {"const": 17}, "alembic_head": {"type": "string"}}},
    "restore_order": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["postgres", "object_fixture", "application", "gateway"]}},
    "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signer_key_ref": {"type": "string"},
    "primary_failure_domain_ref": {"type": "string"}
  }
}
