{
	admin off
	auto_https off
	servers {
		protocols h1 h2
	}
}

# Listens on 8443 inside the container (no privileged port needed); compose publishes it as 443.
:8443 {
	tls /run/secrets/tls_cert /run/secrets/tls_key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	handle /api/v1/* {
		# Defence in depth for Evidence uploads: slightly above the application's
		# EVIDENCE_MAX_BYTES (default 25 MiB), so the application stays the one that
		# explains a refusal. 26 MiB = 27262976 bytes. Caddy streams the body upstream
		# (no request buffering) and cuts it off with 413 once more than this has been read.
		request_body {
			max_size 27262976
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8080
	}
}
