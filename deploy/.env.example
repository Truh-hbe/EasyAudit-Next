# Copy to deploy/.env. This file only documents the structure; secrets live in files,
# never in this file (see deploy/README.md).

# Directory with the secret files (postgres_password, garage_rpc_secret,
# s3_access_key_id, s3_secret_access_key). Default: deploy/secrets
# EASYAUDIT_SECRETS_DIR=./secrets

# Directory with tls.crt and tls.key issued by your internal CA. Default: deploy/certs
# EASYAUDIT_CERTS_DIR=./certs

# Host port for the gateway. Leave at 443 in production.
# EASYAUDIT_HTTPS_PORT=443
