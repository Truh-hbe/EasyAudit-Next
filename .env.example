APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://easyaudit:easyaudit@localhost:5432/easyaudit
SESSION_COOKIE_NAME=__Host-easyaudit_session
SESSION_TTL_SECONDS=43200
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
SESSION_TOUCH_INTERVAL_SECONDS=300
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_LOGIN_NAME_LIMIT=5
LOGIN_THROTTLE_IP_LIMIT=50
DB_CONNECT_TIMEOUT_SECONDS=5
DB_TCP_USER_TIMEOUT_MS=15000
DB_KEEPALIVES_IDLE_SECONDS=10
DB_KEEPALIVES_INTERVAL_SECONDS=5
DB_KEEPALIVES_COUNT=3
# Evidence upload. Object storage is unset by default: uploads answer 503 and /health/ready
# reports object_storage as fail. Credentials are read from files, never from the environment.
# OBJECT_STORAGE_ENDPOINT=http://localhost:3900
# OBJECT_STORAGE_BUCKET=easyaudit-evidence
# OBJECT_STORAGE_REGION=garage
# OBJECT_STORAGE_ACCESS_KEY_ID_FILE=/path/to/s3_access_key_id
# OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=/path/to/s3_secret_access_key
# OBJECT_STORAGE_CONNECT_TIMEOUT_SECONDS=5
# OBJECT_STORAGE_READ_TIMEOUT_SECONDS=30
# OBJECT_STORAGE_MAX_ATTEMPTS=3
# EVIDENCE_MAX_BYTES=26214400
# EVIDENCE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,text/csv
