{
  "name": "easyaudit-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:api": "node --experimental-strip-types --watch apps/api/src/server.ts",
    "start:api": "node --experimental-strip-types apps/api/src/server.ts",
    "test": "node --experimental-strip-types --test packages/domain/test/*.test.ts apps/api/test/*.test.ts",
    "lint": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm test"
  }
}
