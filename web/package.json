{
  "name": "easyaudit-next-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:browser": "playwright test tests/browser/foundation.spec.ts tests/browser/auth-session-generation.spec.ts tests/browser/collaboration*.spec.ts",
    "test:browser:real": "playwright test tests/browser/real-auth.spec.ts tests/browser/real-m4-1.spec.ts tests/browser/real-m5-2.spec.ts tests/browser/real-m5-3.spec.ts tests/browser/real-m5-4.spec.ts tests/browser/real-m5-5.spec.ts tests/browser/real-pilot-3.spec.ts tests/browser/real-case-lifecycle.spec.ts",
    "build": "tsc -b && vite build",
    "check:entry": "node scripts/check-entry-chunk.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.5",
    "dayjs": "1.11.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "oxlint": "1.80.0",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
