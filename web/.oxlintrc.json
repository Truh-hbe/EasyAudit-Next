{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@mui/*",
              "@mantine/*",
              "@chakra-ui/*",
              "@radix-ui/*",
              "@headlessui/*",
              "@arco-design/*",
              "tdesign-react",
              "react-bootstrap",
              "semantic-ui-react",
              "@ant-design/pro-*",
              "react-icons",
              "react-icons/*",
              "lucide-react",
              "@heroicons/*",
              "@tabler/icons-react",
              "@fortawesome/*",
              "tailwindcss",
              "tailwindcss/*",
              "styled-components",
              "@emotion/*",
              "@stitches/*",
              "@vanilla-extract/*",
              "@pandacss/*"
            ],
            "message": "前端 UI 只使用 antd 与 @ant-design/icons，不引入其他组件库、图标库、CSS 框架或 CSS-in-JS 库，见 docs/design.md。"
          },
          {
            "group": [
              "antd/es/*",
              "antd/lib/*"
            ],
            "message": "从 'antd' 根入口导入组件，不使用内部路径，见 docs/design.md。"
          }
        ]
      }
    ]
  }
}
